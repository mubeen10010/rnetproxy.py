#!/usr/bin/env python3
import socket
import threading
import select
import time

# ===== CONFIG =====
LISTEN_ADDR = "0.0.0.0"
LISTEN_PORT = 8080

SSH_HOST = "127.0.0.1"
SSH_PORT = 22

BUFFER = 65536
TIMEOUT = 900

RESPONSE = b"HTTP/1.1 200 Connection established\r\n\r\n"
# ==================


class ProxyServer:
    def __init__(self):
        self.sock = socket.socket(socket.AF_INET)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.sock.bind((LISTEN_ADDR, LISTEN_PORT))
        self.sock.listen(2048)
        print(f"[+] Listening on {LISTEN_ADDR}:{LISTEN_PORT}")

    def serve(self):
        while True:
            client, _ = self.sock.accept()
            client.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            threading.Thread(
                target=self.handle, args=(client,), daemon=True
            ).start()

    def handle(self, client):
        target = None
        try:
            # Always connect to local SSH
            target = socket.create_connection((SSH_HOST, SSH_PORT), timeout=15)
            target.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)

            # Send fake HTTP OK
            client.sendall(RESPONSE)

            # === CRITICAL PART ===
            # Eat EVERYTHING until SSH banner appears
            while True:
                data = client.recv(BUFFER)
                if not data:
                    return
                if data.startswith(b"SSH-"):
                    target.sendall(data)
                    break
                # else: discard silently
            # =====================

            self.pipe(client, target)

        except:
            pass
        finally:
            try:
                client.close()
            except:
                pass
            try:
                if target:
                    target.close()
            except:
                pass

    def pipe(self, a, b):
        sockets = [a, b]
        while True:
            r, _, _ = select.select(sockets, [], [], TIMEOUT)
            if not r:
                continue
            for s in r:
                other = b if s is a else a
                data = s.recv(BUFFER)
                if not data:
                    return
                other.sendall(data)


if __name__ == "__main__":
    ProxyServer().serve()
